    "transition_intermediate_states": [],
    "variables": [
        "bool  is_moving",
        "bool  is_locked_on",
        "trig  on_suspicion",
        "bool  is_suspicious_approaching",
        "float mvt_facing_angle",
        "trig  on_turnaround",
        "bool  is_grounded",
        "trig  on_jump",
        "trig  on_attack",
        "trig  on_parry_hurt",
        "trig  on_guard_hurt",
        "trig  on_receive_hurt",
        "trig  on_receive_hurt_from_back",
        "bool  is_guarding"
    ],
    "state_transitions": [
        {
            "from_to_state": [["st_idle"], "st_running"],
            "condition": "is_moving eq true"
        },
        {
            "from_to_state": [["st_running"], "st_idle"],
            "condition": "is_moving eq false"
        },
        {
            "from_to_state": [["st_running"], "st_running_turnaround"],
            "condition": "on_turnaround"
        },
        {
            "from_to_state": [["st_running_turnaround"], "st_running"],
            "condition": "ON_ANIM_END"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_fall", "st_attack_0"], "st_awareness_suspicion_begin"],
            "condition": "on_suspicion"
        },
        {
            "from_to_state": [["st_awareness_suspicion_begin"], "st_awareness_suspicion_walking"],
            "condition": "ON_ANIM_END"
        },
        {
            "from_to_state": [["st_awareness_suspicion_walking"], "st_awareness_suspicion_end"],
            "condition": "is_suspicious_approaching eq false"
        },
        {
            "from_to_state": [["st_awareness_suspicion_end"], "st_idle"],
            "condition": "ON_ANIM_END"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_fall", "st_attack_0"], "st_jump"],
            "condition": "on_jump"
        },
        {
            "from_to_state": [["st_jump"], "st_fall"],
            "condition": "ON_ANIM_END"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_attack_0"], "st_fall"],
            "condition": "is_grounded eq false"
        },
        {
            "from_to_state": [["st_fall"], "st_idle"],
            "condition": "is_grounded eq true"
        },
        {
            "from_to_state": [["st_idle", "st_running"], "st_attack_0"],
            "condition": "on_attack"
        },
        {
            "from_to_state": [["st_attack_0"], "st_idle"],
            "condition": "ON_ANIM_END"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_running_turnaround", "st_jump", "st_fall", "st_attack_0", "st_awareness_suspicion_begin", "st_awareness_suspicion_walking", "st_awareness_suspicion_end"], "st_hurt_parry"],
            "condition": "on_parry_hurt"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_running_turnaround", "st_jump", "st_fall", "st_attack_0", "st_awareness_suspicion_begin", "st_awareness_suspicion_walking", "st_awareness_suspicion_end"], "st_hurt_guard"],
            "condition": "on_guard_hurt"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_running_turnaround", "st_jump", "st_fall", "st_attack_0", "st_awareness_suspicion_begin", "st_awareness_suspicion_walking", "st_awareness_suspicion_end"], "st_hurt_receive"],
            "condition": "on_receive_hurt"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_running_turnaround", "st_jump", "st_fall", "st_attack_0", "st_awareness_suspicion_begin", "st_awareness_suspicion_walking", "st_awareness_suspicion_end"], "st_hurt_receive_from_back"],
            "condition": "on_receive_hurt_from_back"
        },
        {
            "from_to_state": [["st_hurt_parry", "st_hurt_guard", "st_hurt_receive", "st_hurt_receive_from_back"], "st_idle"],
            "condition": "ON_ANIM_END"
        },
        {
            "from_to_state": [["st_idle", "st_running", "st_attack_0"], "st_ready_parry"],
            "condition": "is_guarding eq true"
        },
        {
            "from_to_state": [[], "st_ready_parry_from_running"],
            "condition": "is_guarding eq true"
        },
        {
            "from_to_state": [["st_ready_parry", "st_ready_parry_from_running"], "st_hold_guard_idle"],
            "condition": "ON_ANIM_END"
        },
        {
            "from_to_state": [["st_hold_guard_idle"], "st_hold_guard_walking"],
            "condition": "is_moving eq true"
        },
        {
            "from_to_state": [["st_hold_guard_walking"], "st_hold_guard_idle"],
            "condition": "is_moving eq false"
        },
        {
            "from_to_state": [["st_hold_guard_idle", "st_hold_guard_walking"], "st_idle"],
            "condition": "is_guarding eq false"
        }
    ]
}
